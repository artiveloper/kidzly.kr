NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 네이버 클라우드 플랫폼 → Application → Maps → Web Dynamic Map
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=<ncpKeyId>

# 네이버 클라우드 플랫폼 → API Hub → Application → NAVER 검색(블로그)
NAVER_API_HUB_CLIENT_ID=<clientId>
NAVER_API_HUB_CLIENT_SECRET=<clientSecret>
