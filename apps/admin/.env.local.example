NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 관리자 계정 CRUD(Supabase Auth Admin API)에만 쓰는 서버 전용 키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SECRET_KEY=sb_secret_...

# 네이버 클라우드 플랫폼 → Maps → Geocoding. 놀거리 주소를 위경도로 변환하는 서버 전용 자격증명.
NAVER_MAP_CLIENT_ID=<ncpKeyId>
NAVER_MAP_CLIENT_SECRET=<ncpKeySecret>
